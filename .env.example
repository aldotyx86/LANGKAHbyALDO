# ==============================================================================
# LANGKAH - Pendampingan Harian IKM/UMKM Lombok (Skala 75.000 UMKM)
# Production Environment Variables (Vercel / Local Deployment)
# ==============================================================================

# 1. Google Gemini API (Server-side Only)
# Digunakan untuk Asisten AI Legalitas & Bisnis IKM/UMKM NTB di /api/ai-mentor
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
AI_DAILY_RATE_LIMIT=15

# 2. Supabase Configuration (PostgreSQL, Auth, RLS)
# Dapatkan dari Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# 3. Cloudflare R2 Storage (Penyimpanan Dokumen Legalitas & Foto Produk)
# Dapatkan dari Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
CLOUDFLARE_R2_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your_r2_access_key_id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
CLOUDFLARE_R2_BUCKET_NAME="langkah-umkm-lombok-docs"
CLOUDFLARE_R2_PUBLIC_URL="https://pub-your-id.r2.dev"

# 4. App & Deployment URL
APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV="development"
